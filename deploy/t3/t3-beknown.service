[Unit]
Description=T3 Code (Beknown development)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/repos/t3code
Environment=HOME=/home/ubuntu
Environment=NODE_ENV=production
Environment=PATH=/home/ubuntu/.nvm/versions/node/v24.16.0/bin:/home/ubuntu/.local/bin:/home/ubuntu/.opencode/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/ubuntu/repos/t3code-bkmain/deploy/t3/start.sh
Restart=on-failure
RestartSec=5
SuccessExitStatus=130
TimeoutStopSec=30
KillMode=mixed
UMask=0077
LimitNOFILE=65536
# This instance hosts most agent sessions, so its working set is much larger
# than the fork deployments'. Mirrors the drop-ins applied on the box.
MemoryAccounting=yes
MemoryHigh=18G
MemoryMax=22G

[Install]
WantedBy=multi-user.target
