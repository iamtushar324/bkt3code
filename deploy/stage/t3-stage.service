# T3-CUSTOM(stage): Isolated runtime unit for the stage deployment (fresh upstream cut).
[Unit]
Description=T3 Code (stage: fresh upstream cut)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/repos/t3code-stage
Environment=HOME=/home/ubuntu
ExecStart=/home/ubuntu/repos/t3code-stage/deploy/stage/start.sh
Restart=on-failure
RestartSec=5
SuccessExitStatus=130
TimeoutStopSec=30
KillMode=mixed
UMask=0077
LimitNOFILE=65536
MemoryAccounting=yes
MemoryHigh=4G
MemoryMax=6G
TasksMax=4096

[Install]
WantedBy=multi-user.target
