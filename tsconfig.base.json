{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": ["@effect/platform-node", "effect"],
        "effectFn": ["span", "inferred-span", "suggested-span"],
        "diagnosticSeverity": {
          "abortControllerInEffect": "error",
          "runEffectInsideEffect": "error",
          "flatMapConditionalToFilterOrFail": "error",
          "catchConditionalRefailToCatchIf": "error",
          "tryCatchInEffectGen": "error",
          "schemaStructWithTag": "error",
          "preferTypedSchemaDecoder": "error",
          "catchUnfailableEffect": "error",
          "raceFirstWithSleepToTimeout": "error",
          "redundantMapError": "error",
          "optionMatchToFromOption": "error",
          "catchToIgnore": "error",
          "unnecessaryEffectGen": "error",
          "allOfMapToForEach": "error",
          "catchToOrElseSucceed": "error",
          "unnecessaryFailYieldableError": "error",
          "preferSucceedSomeOrNone": "error",
          "effectSucceedWithVoid": "error",
          "provideLayerSucceedToProvideService": "error",
          "flatMapIgnoredParamToAndThen": "error",
          "mapSomeToAsSome": "error",
          "unnecessaryPipeChain": "error",
          "returnEffectInGen": "off",
          "effectFnOpportunity": "error",
          "anyUnknownInErrorContext": "error",
          "unsafeEffectTypeAssertion": "error",
          "instanceOfSchema": "error",
          "deterministicKeys": "error",
          "strictEffectProvide": "off",
          // We use Effect's unstable modules (http, sql) on purpose. These rules
          // also make effect-tsgo 0.47+ report false TS2790 errors on `delete`.
          "unstableApiUsage": "off",
          "experimentalApiUsage": "off",
          "missingEffectServiceDependency": "error",
          "leakingRequirements": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "unknownInEffectCatch": "error",
          "strictBooleanExpressions": "off",
          "lazyEffect": "off",
          "preferSchemaOverJson": "error",
          "schemaSyncInEffect": "error",
          "cryptoRandomUUID": "error",
          "cryptoRandomUUIDInEffect": "error",
          "nodeBuiltinImport": "error",
          "globalDate": "error",
          "globalDateInEffect": "error",
          "globalConsole": "error",
          "globalConsoleInEffect": "error",
          "globalRandom": "error",
          "globalRandomInEffect": "error",
          "globalTimers": "error",
          "globalTimersInEffect": "error",
          "globalFetch": "error",
          "globalFetchInEffect": "error",
          "schemaNumber": "off"
        },
        "overrides": [
          {
            "include": ["**/*.test.ts", "**/*.test.tsx"],
            "options": {
              "diagnosticSeverity": {
                "preferSchemaOverJson": "off",
                "effectFnOpportunity": "off"
              }
            }
          },
          {
            "include": [
              "**/*.spec.ts",
              "**/*.spec.tsx",
              "**/*.testkit.ts",
              "**/*.testkit.tsx",
              "**/{test,tests,testkit,testing,fixtures,integration}/**",
              "packages/provider-testing/**"
            ],
            "options": { "diagnosticSeverity": { "effectFnOpportunity": "off" } }
            // T3-CUSTOM(expbkt3): separator for the fork override below.
          },
          // T3-CUSTOM(expbkt3): fork-owned files that predate upstream's 2026-11 Effect style
          // rules. A ratchet: drop a file once it passes; never add an upstream-owned file.
          {
            "include": [
              "**/apps/server/src/auth/ClerkDirectory.ts",
              "**/apps/server/src/auth/EnvironmentUserService.ts",
              "**/apps/server/src/claudeAccounts/ClaudeAutoswitchClient.ts",
              "**/apps/server/src/linear/LinearIssueResolver.ts",
              "**/apps/server/src/mcp/McpUpstreamProxy.ts",
              "**/apps/server/src/mcp/ToolyardConnect.ts",
              "**/apps/server/src/mcp/UserMcpProfileStore.test.ts",
              "**/apps/server/src/mcp/UserMcpProfileStore.ts",
              "**/apps/server/src/mcp/toolkits/agent/handlers.ts",
              "**/apps/server/src/mcp/toolkits/agent/schedules.ts",
              "**/apps/server/src/mcp/toolkits/agent/support.ts",
              "**/apps/server/src/mcp/toolkits/control/handlers.ts",
              "**/apps/server/src/mcp/toolkits/control/planSubmissionPolicy.expbkt3.test.ts",
              "**/apps/server/src/mcp/toolkits/control/registration.expbkt3.ts",
              "**/apps/server/src/mcp/toolkits/pullRequests/sessionWatch.expbkt3.test.ts",
              "**/apps/server/src/mcp/toolkits/webUi/bridge.ts",
              "**/apps/server/src/orchestration-v2/Adapters/ClaudeAdapterV2.subagentEndBetweenTurns.expbkt3.test.ts",
              "**/apps/server/src/orchestration-v2/ForkLegacyHistory.expbkt3.ts",
              "**/apps/server/src/orchestration-v2/Layers/AccessControl.test.ts",
              "**/apps/server/src/orchestration-v2/Layers/ArchiveExportReactor.ts",
              "**/apps/server/src/orchestration-v2/Layers/ProjectionSnapshotQuery.ts",
              "**/apps/server/src/orchestration-v2/ShellFeed.expbkt3.test.ts",
              "**/apps/server/src/orchestration-v2/SubagentArchiveCascade.expbkt3.ts",
              "**/apps/server/src/orchestration-v2/forkCredentialIsolation.expbkt3.test.ts",
              "**/apps/server/src/orchestration-v2/legacyProjection.expbkt3.ts",
              "**/apps/server/src/orchestration-v2/managerGuard.expbkt3.ts",
              "**/apps/server/src/orchestration-v2/managerHttp.expbkt3.test.ts",
              "**/apps/server/src/orchestration-v2/testkit/ForkCompatibility.expbkt3.ts",
              "**/apps/server/src/orchestration-v2/turnStartBootstrap.expbkt3.ts",
              "**/apps/server/src/persistence/AgentUiRenders.ts",
              "**/apps/server/src/persistence/EnvironmentUsers.ts",
              "**/apps/server/src/persistence/PlanReviewDocuments.ts",
              "**/apps/server/src/persistence/ThreadClaudeAccount.ts",
              "**/apps/server/src/persistence/ThreadComments.ts",
              "**/apps/server/src/persistence/ThreadWorkspaceGroups.ts",
              "**/apps/server/src/planreview/PlanReviewService.test.ts",
              "**/apps/server/src/presence/UserPresenceService.test.ts",
              "**/apps/server/src/presence/presenceHttp.expbkt3.ts",
              "**/apps/server/src/presence/presenceMessages.ts",
              "**/apps/server/src/provider/claudeHardLimitRotation.expbkt3.test.ts",
              "**/apps/server/src/pullRequest/sourceControlCredentialCache.expbkt3.test.ts",
              "**/apps/server/src/scheduledTasks/ScheduledTaskService.customGroup.expbkt3.test.ts",
              "**/apps/server/src/scheduledTasks/ScheduledTaskService.forkOptions.expbkt3.test.ts",
              "**/apps/server/src/session-webhooks/SessionWebhookService.test.ts",
              "**/apps/server/src/session-webhooks/SessionWebhookService.ts",
              "**/apps/server/src/session-webhooks/mcp.ts",
              "**/apps/server/src/session-webhooks/nativeDispatch.test.ts",
              "**/apps/server/src/sessionArchive/gitFacts.ts",
              "**/apps/server/src/sourceControl/SourceControlProfileService.ts",
              "**/apps/server/src/telemetry/AnalyticsService.identity.expbkt3.test.ts",
              "**/apps/server/src/telemetry/serverEvents.test.ts",
              "**/apps/server/src/toolyard/ToolyardIntegration.test.ts",
              "**/apps/server/src/toolyard/ToolyardIntegration.ts",
              "**/apps/server/src/toolyard/ToolyardNativeHttp.ts",
              "**/apps/server/src/toolyard/ToolyardNativeProxy.test.ts"
            ],
            "options": {
              "diagnosticSeverity": {
                "allOfMapToForEach": "off",
                "catchConditionalRefailToCatchIf": "off",
                "catchToIgnore": "off",
                "catchToOrElseSucceed": "off",
                "catchUnfailableEffect": "off",
                "effectFnOpportunity": "off",
                "effectSucceedWithVoid": "off",
                "flatMapConditionalToFilterOrFail": "off",
                "mapSomeToAsSome": "off",
                "optionMatchToFromOption": "off",
                "preferSucceedSomeOrNone": "off",
                "preferTypedSchemaDecoder": "off",
                "provideLayerSucceedToProvideService": "off",
                "runEffectInsideEffect": "off",
                "tryCatchInEffectGen": "off",
                "unnecessaryEffectGen": "off",
                "unnecessaryFailYieldableError": "off"
              }
            }
          }
        ]
      }
    ]
  }
}
